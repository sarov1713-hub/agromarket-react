# Copy to .env.e2e; use a disposable LOCAL PostgreSQL, never production.
E2E_DATABASE_URL=postgresql://postgres:LOCAL_TEST_PASSWORD@127.0.0.1:55432/agromarket_test
E2E_JWT_SECRET=local-e2e-only-replace-with-random-value
E2E_FARMER_EMAIL=admin@e2e.example.test
E2E_FARMER_PASSWORD=LOCAL_TEST_PASSWORD
# The real server permits only admin to create products; this is a test admin.
E2E_API_URL=http://127.0.0.1:3100/api
# Optional existing backend checkout; defaults to ./agromarket-server.
# E2E_BACKEND_DIR=D:/agromarket-react/agromarket-server
